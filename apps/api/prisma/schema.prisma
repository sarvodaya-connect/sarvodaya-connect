generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Provisional values based on the Sarvodaya proposal (Society status).
// To be confirmed with Sarvodaya.
enum SocietyStatus {
  ACTIVE
  INACTIVE
  UNDER_REVIEW
  SUSPENDED

  @@map("society_status")
}

// SC-65: A Strong, B Developing, C Needs strengthening.
enum SocietyGrade {
  A
  B
  C

  @@map("society_grade")
}

enum GradeRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("grade_request_status")
}

enum MembershipCategory {
  CHILDREN
  YOUTH
  MOTHERS
  ORDINARY
  ELDERS_COUNCIL

  @@map("membership_category")
}

model District {
  id                  String               @id @default(uuid()) @db.Uuid
  code                String               @unique @db.VarChar(10)
  nameEn              String               @unique @map("name_en") @db.VarChar(100)
  // V5 D03b: shown under the district name.
  province            String?              @db.VarChar(60)
  accounts            PlatformAccount[]
  informationRequests InformationRequest[]
  societies           Society[]
  emergencyIncidents  EmergencyIncident[]
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("districts")
}

model Society {
  id                   String                      @id @default(uuid()) @db.Uuid
  societyCode          String                      @unique @map("society_code") @db.VarChar(20)
  nameEn               String                      @map("name_en") @db.VarChar(150)
  nameLocal            String?                     @map("name_local") @db.VarChar(150)
  districtId           String                      @map("district_id") @db.Uuid
  district             District                    @relation(fields: [districtId], references: [id], onDelete: Restrict)
  dsDivision           String?                     @map("ds_division") @db.VarChar(100)
  gnDivision           String?                     @map("gn_division") @db.VarChar(100)
  village              String?                     @db.VarChar(100)
  addressLine          String?                     @map("address_line") @db.VarChar(255)
  latitude             Float?
  longitude            Float?
  establishedOn        DateTime?                   @map("established_on") @db.Date
  status               SocietyStatus               @default(UNDER_REVIEW)
  // SC-65: V4 society record fields (Prototype v4, M06 and D05).
  memberCount          Int?                        @map("member_count")
  // Issue #141: the profile's female and male members. Both are null until
  // entered; once entered, member_count is always their sum (a database
  // check enforces it). Older records keep a total with no split.
  femaleMembers        Int?                        @map("female_members")
  maleMembers          Int?                        @map("male_members")
  // Issue #143: members younger than 18, a part of the total (never added to
  // it). Only entered with the female/male split; a database check keeps it
  // between 0 and member_count.
  under18Members       Int?                        @map("under_18_members")
  // Issue #143: when a membership figure (total, female, male or under 18s)
  // last changed. Other profile or Exco edits leave it alone. Null until the
  // first saved change.
  membershipUpdatedAt  DateTime?                   @map("membership_updated_at") @db.Timestamptz(3)
  landline             String?                     @db.VarChar(30)
  // Information only: the app keeps no sales, stock or business accounts.
  businessDescription  String?                     @map("business_description") @db.VarChar(1000)
  // Only HQ changes the grade, directly or by approving a request.
  grade                SocietyGrade?
  gradeChangedAt       DateTime?                   @map("grade_changed_at") @db.Timestamptz(3)
  gradeChangedByName   String?                     @map("grade_changed_by_name") @db.VarChar(150)
  gradeChangedByRole   String?                     @map("grade_changed_by_role") @db.VarChar(40)
  annualSummaries      AnnualFinancialSummary[]
  gradeRequests        GradeChangeRequest[]
  workPlanActivities   WorkPlanActivity[]
  contacts             SocietyContact[]
  councilMembers       SocietyCouncilMember[]
  memberships          SocietyMembershipCount[]
  documents            SocietyDocument[]
  notifications        Notification[]
  emergencyAssessments EmergencyAssessment[]
  emergencyActions     EmergencyResponseAction[]
  emergencyReports     EmergencySituationReport[]
  informationRequests  InformationRequestSociety[]
  reportedIncidents    EmergencyIncident[]         @relation("IncidentReportingSociety")
  helpingActions       EmergencyActionHelper[]     @relation("ActionHelperSociety")
  emergencyEvidence    EmergencyEvidence[]
  // Issue #145: businesses the society itself operates.
  businesses           SocietyBusiness[]
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([districtId])
  @@index([status])
  // V5 D04 "Not updated in 90+ days".
  @@index([status, updatedAt])
  @@index([nameEn])
  @@map("societies")
}

model SocietyContact {
  id        String   @id @default(uuid()) @db.Uuid
  societyId String   @map("society_id") @db.Uuid
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  label     String?  @db.VarChar(100)
  fullName  String?  @map("full_name") @db.VarChar(150)
  position  String?  @db.VarChar(100)
  phone     String?  @db.VarChar(30)
  email     String?  @db.VarChar(254)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([societyId])
  @@map("society_contacts")
}

model SocietyCouncilMember {
  id               String             @id @default(uuid()) @db.Uuid
  societyId        String             @map("society_id") @db.Uuid
  society          Society            @relation(fields: [societyId], references: [id], onDelete: Cascade)
  seatNumber       Int                @map("seat_number")
  fullName         String             @map("full_name") @db.VarChar(150)
  nicCiphertext    String?            @map("nic_ciphertext")
  nicLastFour      String?            @map("nic_last_four") @db.VarChar(4)
  position         String             @db.VarChar(100)
  seatType         MembershipCategory @map("seat_type")
  phone            String?            @db.VarChar(30)
  email            String?            @db.VarChar(254)
  age              Int?
  // V5 D05x / M07: age is worked out from the date of birth when it is known.
  dateOfBirth      DateTime?          @map("date_of_birth") @db.Date
  profession       String?            @db.VarChar(100)
  addressLine      String?            @map("address_line") @db.VarChar(255)
  appointedOn      DateTime?          @map("appointed_on") @db.Date
  endedOn          DateTime?          @map("ended_on") @db.Date
  isActive         Boolean            @default(true) @map("is_active")
  isPrimaryContact Boolean            @default(false) @map("is_primary_contact")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([societyId, seatNumber])
  @@index([societyId, isActive])
  @@map("society_council_members")
}

model SocietyMembershipCount {
  id        String             @id @default(uuid()) @db.Uuid
  societyId String             @map("society_id") @db.Uuid
  society   Society            @relation(fields: [societyId], references: [id], onDelete: Cascade)
  year      Int
  category  MembershipCategory
  female    Int                @default(0)
  male      Int                @default(0)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([societyId, year, category])
  @@index([year, societyId])
  @@map("society_membership_counts")
}

// SC-49: document metadata. Files live in document storage (local disk in
// development, Amazon S3 later); only their metadata is stored here.
// Types follow the four annual Registrar documents plus other society files.
// To be confirmed with Sarvodaya.
enum DocumentType {
  AUDIT_REPORT
  AGM_MINUTES
  OFFICE_BEARER_LIST
  MEMBERS_LIST
  REGISTRATION
  FINANCE
  ACTIVITY_EVIDENCE
  OTHER

  @@map("document_type")
}

// Matches DOCUMENT_STATUSES in packages/api-contracts. A document stays DRAFT
// until its file has been uploaded and confirmed.
enum DocumentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED

  @@map("document_status")
}

// REVIEWERS_ONLY documents (the signed members list) can only be opened by
// District Managers and HQ.
enum DocumentAccessLevel {
  STANDARD
  REVIEWERS_ONLY

  @@map("document_access_level")
}

model SocietyDocument {
  id             String              @id @default(uuid()) @db.Uuid
  societyId      String              @map("society_id") @db.Uuid
  society        Society             @relation(fields: [societyId], references: [id], onDelete: Restrict)
  documentType   DocumentType        @map("document_type")
  title          String              @db.VarChar(150)
  fileName       String              @map("file_name") @db.VarChar(255)
  contentType    String              @map("content_type") @db.VarChar(100)
  sizeBytes      Int                 @map("size_bytes")
  // Location in document storage. Never contains user-supplied text.
  storageKey     String              @unique @map("storage_key") @db.VarChar(512)
  status         DocumentStatus      @default(DRAFT)
  accessLevel    DocumentAccessLevel @default(STANDARD) @map("access_level")
  version        Int                 @default(1)
  // Users are managed by the identity provider, so only their id and display name are kept.
  uploadedById   String              @map("uploaded_by_id") @db.VarChar(64)
  uploadedByName String              @map("uploaded_by_name") @db.VarChar(150)
  uploadedAt     DateTime?           @map("uploaded_at") @db.Timestamptz(3)
  uploadedByRole String?             @map("uploaded_by_role") @db.VarChar(40)
  // SC-65: required for audit reports. 2025 means FY 2025/26.
  financialYear  Int?                @map("financial_year_start")
  // V5 PR 4: SHA-256 of the file (base64), checked by storage when it is uploaded.
  checksumSha256 String?             @map("checksum_sha256") @db.VarChar(64)
  notifications  Notification[]
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([societyId, documentType, title, version])
  @@index([societyId, documentType])
  @@index([societyId, documentType, financialYear])
  // D11 / D12 national counts per Registrar document and year.
  @@index([financialYear, documentType, societyId])
  @@index([status])
  @@map("society_documents")
}

// SC-65: the society's two yearly totals in LKR (Prototype v4, M06f and D05).
// A summary only: no transactions, loans, savings, payments, sales or accounts.
model AnnualFinancialSummary {
  id                    String    @id @default(uuid()) @db.Uuid
  societyId             String    @map("society_id") @db.Uuid
  society               Society   @relation(fields: [societyId], references: [id], onDelete: Cascade)
  // 2025 means FY 2025/26 (1 Apr 2025 to 31 Mar 2026).
  financialYear         Int       @map("financial_year_start")
  totalProfit           Decimal?  @map("total_profit") @db.Decimal(14, 2)
  totalExpenses         Decimal?  @map("total_expenses") @db.Decimal(14, 2)
  previousProfit        Decimal?  @map("previous_profit") @db.Decimal(14, 2)
  previousExpenses      Decimal?  @map("previous_expenses") @db.Decimal(14, 2)
  profitUpdatedAt       DateTime? @map("profit_updated_at") @db.Timestamptz(3)
  profitUpdatedByName   String?   @map("profit_updated_by_name") @db.VarChar(150)
  profitUpdatedByRole   String?   @map("profit_updated_by_role") @db.VarChar(40)
  expensesUpdatedAt     DateTime? @map("expenses_updated_at") @db.Timestamptz(3)
  expensesUpdatedByName String?   @map("expenses_updated_by_name") @db.VarChar(150)
  expensesUpdatedByRole String?   @map("expenses_updated_by_role") @db.VarChar(40)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([societyId, financialYear])
  @@map("annual_financial_summaries")
}

// SC-65: Society Officers, SPCs and DDMs request; only HQ decides.
model GradeChangeRequest {
  id              String             @id @default(uuid()) @db.Uuid
  societyId       String             @map("society_id") @db.Uuid
  society         Society            @relation(fields: [societyId], references: [id], onDelete: Cascade)
  fromGrade       SocietyGrade?      @map("from_grade")
  toGrade         SocietyGrade       @map("to_grade")
  reason          String             @db.VarChar(500)
  status          GradeRequestStatus @default(PENDING)
  requestedById   String             @map("requested_by_id") @db.VarChar(64)
  requestedByName String             @map("requested_by_name") @db.VarChar(150)
  requestedByRole String             @map("requested_by_role") @db.VarChar(40)
  requestedAt     DateTime           @default(now()) @map("requested_at") @db.Timestamptz(3)
  decidedById     String?            @map("decided_by_id") @db.VarChar(64)
  decidedByName   String?            @map("decided_by_name") @db.VarChar(150)
  decidedAt       DateTime?          @map("decided_at") @db.Timestamptz(3)
  decisionComment String?            @map("decision_comment") @db.VarChar(500)

  @@index([societyId, requestedAt])
  @@index([status, requestedAt])
  @@map("grade_change_requests")
}

// V5 PR 4: an activity is waiting for the SPC until they approve it (and
// choose its UN SDGs) or send it back to the Society Officer to change.
// Only APPROVED activities count in the dashboards.
enum ActivityStatus {
  WAITING_FOR_SPC
  SENT_BACK
  APPROVED

  @@map("activity_status")
}

// V5 M09a: the three Sarvodaya activity dimensions.
enum ActivityDimension {
  SOCIAL
  ECONOMIC
  GOVERNANCE

  @@map("activity_dimension")
}

// D05w / M09 work plan and M09a–M09d activities (V5 PR 4). Allocated costs
// are planning figures, not payments or spending.
model WorkPlanActivity {
  id                    String                @id @default(uuid()) @db.Uuid
  societyId             String                @map("society_id") @db.Uuid
  society               Society               @relation(fields: [societyId], references: [id], onDelete: Cascade)
  year                  Int
  month                 Int
  name                  String                @db.VarChar(150)
  description           String                @db.VarChar(1000)
  sector                String?               @db.VarChar(100)
  datesLabel            String?               @map("dates_label") @db.VarChar(60)
  allocatedCost         Decimal               @map("allocated_cost") @db.Decimal(14, 2)
  dimension             ActivityDimension?
  // Activities from before V5 PR 4 were planned without review, so they stay approved.
  status                ActivityStatus        @default(APPROVED)
  femaleParticipants    Int?                  @map("female_participants")
  maleParticipants      Int?                  @map("male_participants")
  youthParticipants     Int?                  @map("youth_participants")
  householdsBenefited   Int?                  @map("households_benefited")
  womenHeadedHouseholds Int?                  @map("women_headed_households")
  partners              String?               @db.VarChar(500)
  resourcesNeeded       String?               @map("resources_needed") @db.VarChar(500)
  volunteerHours        Int?                  @map("volunteer_hours")
  createdById           String?               @map("created_by_id") @db.VarChar(64)
  createdByName         String?               @map("created_by_name") @db.VarChar(150)
  createdByRole         String?               @map("created_by_role") @db.VarChar(40)
  submittedAt           DateTime?             @map("submitted_at") @db.Timestamptz(3)
  reviewedById          String?               @map("reviewed_by_id") @db.VarChar(64)
  reviewedByName        String?               @map("reviewed_by_name") @db.VarChar(150)
  reviewedAt            DateTime?             @map("reviewed_at") @db.Timestamptz(3)
  reviewComment         String?               @map("review_comment") @db.VarChar(500)
  sdgs                  WorkPlanActivitySdg[]
  updatedByName         String?               @map("updated_by_name") @db.VarChar(150)
  updatedByRole         String?               @map("updated_by_role") @db.VarChar(40)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([societyId, year, month])
  // SP06 / M50: the SPC's waiting queue and recently approved list.
  @@index([status, submittedAt])
  @@index([status, reviewedAt])
  @@map("work_plan_activities")
}

// The UN SDGs (1–17) the SPC chose when approving an activity.
model WorkPlanActivitySdg {
  activityId String           @map("activity_id") @db.Uuid
  activity   WorkPlanActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  sdg        Int              @db.SmallInt

  @@id([activityId, sdg])
  @@index([sdg])
  @@map("work_plan_activity_sdgs")
}

// SC-49: notifications for dashboard and mobile users. Categories follow the
// notification centre (Screen Catalogue v3, D19 and M16).
enum NotificationCategory {
  APPROVAL
  RETURNED
  AUDIT
  REQUEST
  EMERGENCY
  STALE_DATA
  SYSTEM

  @@map("notification_category")
}

enum EmergencyIncidentType {
  FLOOD
  LANDSLIDE
  CYCLONE
  DROUGHT
  FIRE
  PUBLIC_HEALTH
  OTHER

  @@map("emergency_incident_type")
}

enum EmergencySeverity {
  LOW
  MODERATE
  HIGH
  CRITICAL

  @@map("emergency_severity")
}

enum EmergencyIncidentStatus {
  ACTIVE
  CONTAINED
  CLOSED

  @@map("emergency_incident_status")
}

enum EmergencyRecordStatus {
  DRAFT
  SUBMITTED

  @@map("emergency_record_status")
}

enum EmergencyActionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("emergency_action_status")
}

// V5 D19: the Alerts filters (grade requests, incidents, access, records,
// activities). Older notifications without a topic appear under All only.
enum NotificationTopic {
  GRADE_REQUEST
  INCIDENT
  ACCESS
  RECORDS
  ACTIVITY
  ACCOUNT
  INFORMATION_REQUEST

  @@map("notification_topic")
}

// V5 PR 8: a society's state in a rapid assessment (Safe, Affected, Critical).
enum EmergencyImpact {
  SAFE
  AFFECTED
  CRITICAL

  @@map("emergency_impact")
}

enum EmergencyRoadAccess {
  OPEN
  PARTLY_BLOCKED
  CUT_OFF
  UNKNOWN

  @@map("emergency_road_access")
}

// Urgent needs from assessments, and what a response action provides.
enum EmergencyNeed {
  DRINKING_WATER
  DRY_RATIONS
  TEMPORARY_SHELTER
  MEDICAL_HELP
  CLOTHING
  VOLUNTEERS
  OTHER

  @@map("emergency_need")
}

enum EmergencyHelperStatus {
  ASSIGNED
  IN_PROGRESS
  DELIVERED

  @@map("emergency_helper_status")
}

model Notification {
  id              String               @id @default(uuid()) @db.Uuid
  recipientUserId String               @map("recipient_user_id") @db.VarChar(64)
  category        NotificationCategory
  topic           NotificationTopic?
  title           String               @db.VarChar(200)
  body            String?              @db.VarChar(1000)
  // Relative path in the app or dashboard that shows the related item.
  linkPath        String?              @map("link_path") @db.VarChar(255)
  societyId       String?              @map("society_id") @db.Uuid
  society         Society?             @relation(fields: [societyId], references: [id], onDelete: SetNull)
  documentId      String?              @map("document_id") @db.Uuid
  document        SocietyDocument?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  readAt          DateTime?            @map("read_at") @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([recipientUserId, createdAt])
  @@index([recipientUserId, readAt])
  @@index([recipientUserId, topic, createdAt])
  @@map("notifications")
}

// Emergency-response data uses fictional/demo content until approved for live use.
model EmergencyIncident {
  id                 String                     @id @default(uuid()) @db.Uuid
  // V5 PR 8: shown as INC-{year}-{number}, for example INC-2026-09.
  referenceNumber    Int                        @unique @default(autoincrement()) @map("reference_number")
  // The reporting society's district. The area can cover more districts.
  districtId         String                     @map("district_id") @db.Uuid
  district           District                   @relation(fields: [districtId], references: [id], onDelete: Restrict)
  areaDistrictIds    String[]                   @default([]) @map("area_district_ids") @db.Uuid
  reportingSocietyId String?                    @map("reporting_society_id") @db.Uuid
  reportingSociety   Society?                   @relation("IncidentReportingSociety", fields: [reportingSocietyId], references: [id], onDelete: SetNull)
  title              String                     @db.VarChar(160)
  type               EmergencyIncidentType
  severity           EmergencySeverity          @default(MODERATE)
  status             EmergencyIncidentStatus    @default(ACTIVE)
  description        String                     @db.VarChar(4000)
  // V5 D30: "Message to societies", shown with the new-incident notification.
  message            String                     @default("") @db.VarChar(1000)
  location           String                     @db.VarChar(200)
  latitude           Float?
  longitude          Float?
  createdById        String                     @map("created_by_id") @db.VarChar(64)
  createdByName      String?                    @map("created_by_name") @db.VarChar(150)
  createdByRole      String?                    @map("created_by_role") @db.VarChar(40)
  // A retry with the same id returns the incident already opened (null for older rows).
  clientMutationId   String?                    @map("client_mutation_id") @db.Uuid
  // When it started (entered by the opener); activatedAt is when it was opened here.
  startedAt          DateTime                   @default(now()) @map("started_at") @db.Timestamptz(3)
  assessmentsDueAt   DateTime?                  @map("assessments_due_at") @db.Timestamptz(3)
  lastReminderAt     DateTime?                  @map("last_reminder_at") @db.Timestamptz(3)
  activatedAt        DateTime                   @default(now()) @map("activated_at") @db.Timestamptz(3)
  closedAt           DateTime?                  @map("closed_at") @db.Timestamptz(3)
  closedById         String?                    @map("closed_by_id") @db.VarChar(64)
  closedByName       String?                    @map("closed_by_name") @db.VarChar(150)
  closedByRole       String?                    @map("closed_by_role") @db.VarChar(40)
  assessments        EmergencyAssessment[]
  actions            EmergencyResponseAction[]
  reports            EmergencySituationReport[]
  evidence           EmergencyEvidence[]
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([districtId, status, activatedAt])
  @@unique([createdById, clientMutationId])
  @@index([areaDistrictIds], type: Gin)
  @@index([status, activatedAt])
  @@map("emergency_incidents")
}

model EmergencyAssessment {
  id                     String                @id @default(uuid()) @db.Uuid
  incidentId             String                @map("incident_id") @db.Uuid
  incident               EmergencyIncident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  societyId              String                @map("society_id") @db.Uuid
  society                Society               @relation(fields: [societyId], references: [id], onDelete: Restrict)
  clientMutationId       String                @map("client_mutation_id") @db.Uuid
  revision               Int                   @default(1)
  status                 EmergencyRecordStatus @default(DRAFT)
  observedAt             DateTime              @map("observed_at") @db.Timestamptz(3)
  // V5 M41: the society's state, counts and needs. Counts only, never names or NICs.
  impact                 EmergencyImpact       @default(AFFECTED)
  peopleAffected         Int                   @default(0) @map("people_affected")
  // Families affected.
  householdsAffected     Int                   @default(0) @map("households_affected")
  displacedPeople        Int                   @default(0) @map("displaced_people")
  housesFullyDamaged     Int                   @default(0) @map("houses_fully_damaged")
  housesPartlyDamaged    Int                   @default(0) @map("houses_partly_damaged")
  injured                Int                   @default(0)
  roadAccess             EmergencyRoadAccess   @default(UNKNOWN) @map("road_access")
  needs                  EmergencyNeed[]       @default([])
  confirmedWithPresident Boolean               @default(false) @map("confirmed_with_president")
  infrastructureNotes    String                @default("") @map("infrastructure_notes") @db.VarChar(2000)
  urgentNeeds            String                @default("") @map("urgent_needs") @db.VarChar(2000)
  notes                  String                @default("") @db.VarChar(4000)
  latitude               Float?
  longitude              Float?
  createdById            String                @map("created_by_id") @db.VarChar(64)
  createdByName          String?               @map("created_by_name") @db.VarChar(150)
  evidence               EmergencyEvidence[]
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([createdById, clientMutationId])
  @@index([incidentId, societyId, status])
  @@index([incidentId, status, createdAt])
  @@map("emergency_assessments")
}

// V5 D32: a need for one society. HQ assigns the societies that help with it;
// its status (needed, assigned, in progress, delivered) comes from the helpers.
model EmergencyResponseAction {
  id               String                  @id @default(uuid()) @db.Uuid
  incidentId       String                  @map("incident_id") @db.Uuid
  incident         EmergencyIncident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  societyId        String?                 @map("society_id") @db.Uuid
  society          Society?                @relation(fields: [societyId], references: [id], onDelete: SetNull)
  clientMutationId String                  @map("client_mutation_id") @db.Uuid
  need             EmergencyNeed           @default(OTHER)
  title            String                  @db.VarChar(160)
  description      String                  @default("") @db.VarChar(2000)
  // Items, people or tasks only: never money.
  quantity         Int                     @default(0)
  unit             String                  @default("") @db.VarChar(30)
  // V4 status, kept for older records; V5 works the status out from the helpers.
  status           EmergencyActionStatus   @default(PLANNED)
  dueAt            DateTime?               @map("due_at") @db.Timestamptz(3)
  createdById      String                  @map("created_by_id") @db.VarChar(64)
  createdByName    String?                 @map("created_by_name") @db.VarChar(150)
  helpers          EmergencyActionHelper[]
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([createdById, clientMutationId])
  @@index([incidentId, status, dueAt])
  @@index([societyId])
  @@map("emergency_response_actions")
}

// V5 D32, M45h, M46: a society HQ asked to help with a need, and its delivery.
model EmergencyActionHelper {
  id                String                  @id @default(uuid()) @db.Uuid
  actionId          String                  @map("action_id") @db.Uuid
  action            EmergencyResponseAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  helperSocietyId   String                  @map("helper_society_id") @db.Uuid
  helperSociety     Society                 @relation("ActionHelperSociety", fields: [helperSocietyId], references: [id], onDelete: Restrict)
  quantity          Int
  deliveredQuantity Int                     @default(0) @map("delivered_quantity")
  status            EmergencyHelperStatus   @default(ASSIGNED)
  // HQ's note to the helping society, and the helper's delivery note.
  note              String                  @default("") @db.VarChar(1000)
  deliveryNote      String                  @default("") @map("delivery_note") @db.VarChar(1000)
  deliveredOn       DateTime?               @map("delivered_on") @db.Date
  assignedById      String                  @map("assigned_by_id") @db.VarChar(64)
  assignedByName    String                  @map("assigned_by_name") @db.VarChar(150)
  updatedById       String?                 @map("updated_by_id") @db.VarChar(64)
  updatedByName     String?                 @map("updated_by_name") @db.VarChar(150)
  evidence          EmergencyEvidence[]
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([actionId, helperSocietyId])
  @@index([helperSocietyId])
  @@map("emergency_action_helpers")
}

// V5 M41/M46: photo or PDF evidence in private S3, uploaded by pre-signed URL.
// The key holds only ids (incidents/{incident}/{kind}/{evidence}.{ext}).
model EmergencyEvidence {
  id             String                 @id @default(uuid()) @db.Uuid
  incidentId     String                 @map("incident_id") @db.Uuid
  incident       EmergencyIncident      @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  // The society the evidence is about; viewing it needs scope over this society.
  societyId      String                 @map("society_id") @db.Uuid
  society        Society                @relation(fields: [societyId], references: [id], onDelete: Restrict)
  assessmentId   String?                @map("assessment_id") @db.Uuid
  assessment     EmergencyAssessment?   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  helperId       String?                @map("helper_id") @db.Uuid
  helper         EmergencyActionHelper? @relation(fields: [helperId], references: [id], onDelete: Cascade)
  storageKey     String                 @unique @map("storage_key") @db.VarChar(600)
  contentType    String                 @map("content_type") @db.VarChar(100)
  sizeBytes      Int                    @map("size_bytes")
  checksumSha256 String?                @map("checksum_sha256") @db.VarChar(44)
  uploadedById   String                 @map("uploaded_by_id") @db.VarChar(64)
  uploadedAt     DateTime?              @map("uploaded_at") @db.Timestamptz(3)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([assessmentId])
  @@index([helperId])
  @@map("emergency_evidence")
}

// V5 D33: numbered situation reports. Each is a snapshot of the counts at the
// time it was made, so an earlier report keeps its figures.
model EmergencySituationReport {
  id               String                @id @default(uuid()) @db.Uuid
  incidentId       String                @map("incident_id") @db.Uuid
  incident         EmergencyIncident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  societyId        String?               @map("society_id") @db.Uuid
  society          Society?              @relation(fields: [societyId], references: [id], onDelete: SetNull)
  clientMutationId String                @map("client_mutation_id") @db.Uuid
  revision         Int                   @default(1)
  status           EmergencyRecordStatus @default(DRAFT)
  number           Int?
  asOf             DateTime?             @map("as_of") @db.Timestamptz(3)
  snapshot         Json?
  summary          String                @db.VarChar(4000)
  needs            String                @default("") @db.VarChar(2000)
  createdById      String                @map("created_by_id") @db.VarChar(64)
  createdByName    String?               @map("created_by_name") @db.VarChar(150)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([createdById, clientMutationId], map: "emergency_situation_reports_created_by_id_client_mutation_i_key")
  @@unique([incidentId, number])
  @@index([incidentId, status, createdAt])
  @@map("emergency_situation_reports")
}

// V4 identity and access. Credentials and invitation tokens are never stored in plaintext.
model PlatformAccount {
  id                String              @id @default(uuid()) @db.Uuid
  username          String              @unique @db.VarChar(100)
  displayName       String              @map("display_name") @db.VarChar(150)
  phone             String              @db.VarChar(30)
  email             String?             @db.VarChar(254)
  role              String              @db.VarChar(40)
  districtId        String?             @map("district_id") @db.Uuid
  district          District?           @relation(fields: [districtId], references: [id], onDelete: Restrict)
  societyIds        String[]            @default([]) @map("society_ids") @db.Uuid
  status            String              @default("PENDING") @db.VarChar(20)
  passwordHash      String?             @map("password_hash")
  // V5 D16: when HQ last set the password and how many times it has been set.
  passwordSetAt     DateTime?           @map("password_set_at") @db.Timestamptz(3)
  passwordSetCount  Int                 @default(0) @map("password_set_count")
  // Sign-in lockout is kept in the database so it holds across API instances.
  failedLoginCount  Int                 @default(0) @map("failed_login_count")
  lockedUntil       DateTime?           @map("locked_until") @db.Timestamptz(3)
  // Amazon Cognito user (`sub`) for this account; role and scope stay here, never in the token.
  providerSubject   String?             @unique @map("provider_subject")
  // Cognito tokens from a sign-in before this time are refused (password reset, scope change, disable).
  sessionsRevokedAt DateTime?           @map("sessions_revoked_at") @db.Timestamptz(3)
  invitations       AccountInvitation[]
  sessions          AccountSession[]
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([districtId, role])
  @@map("platform_accounts")
}

model AccountInvitation {
  id        String          @id @default(uuid()) @db.Uuid
  accountId String          @map("account_id") @db.Uuid
  account   PlatformAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash String          @unique @map("token_hash")
  method    String          @db.VarChar(25)
  expiresAt DateTime        @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?       @map("used_at") @db.Timestamptz(3)
  attempts  Int             @default(0)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("account_invitations")
}

model AccountSession {
  id        String          @id @default(uuid()) @db.Uuid
  accountId String          @map("account_id") @db.Uuid
  account   PlatformAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash String          @unique @map("token_hash")
  expiresAt DateTime        @map("expires_at") @db.Timestamptz(3)

  @@index([accountId])
  @@map("account_sessions")
}

model DistrictAccessGrant {
  id          String    @id @default(uuid()) @db.Uuid
  districtId  String    @map("district_id") @db.Uuid
  deputyId    String    @map("deputy_id") @db.Uuid
  grantedById String    @map("granted_by_id") @db.VarChar(64)
  startsAt    DateTime  @map("starts_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  reason      String    @db.VarChar(1000)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([deputyId, expiresAt])
  @@map("district_access_grants")
}

model PlatformAuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.VarChar(64)
  // SC-65: shown in the society change history.
  actorName  String?  @map("actor_name") @db.VarChar(150)
  actorRole  String?  @map("actor_role") @db.VarChar(40)
  action     String   @db.VarChar(60)
  targetId   String   @map("target_id") @db.VarChar(64)
  societyId  String?  @map("society_id") @db.Uuid
  districtId String?  @map("district_id") @db.Uuid
  detail     String   @default("") @db.VarChar(2000)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([societyId, createdAt])
  // V5 PR 7: a grant's access history and "societies opened" counts.
  @@index([action, targetId])
  @@map("platform_audit_events")
}

// V5 D13: HQ asks a group of societies for documents or information. One row
// per society records whether it has responded.
enum InformationRequestAudience {
  ALL_ACTIVE
  DISTRICT
  FIGURES_NOT_ADDED
  AUDIT_PAST_DUE

  @@map("information_request_audience")
}

model InformationRequest {
  id            String                      @id @default(uuid()) @db.Uuid
  title         String                      @db.VarChar(200)
  audience      InformationRequestAudience
  districtId    String?                     @map("district_id") @db.Uuid
  district      District?                   @relation(fields: [districtId], references: [id], onDelete: Restrict)
  // 2025 means FY 2025/26; used by the "figures not added" and "audit past due" groups.
  financialYear Int?                        @map("financial_year_start")
  dueOn         DateTime                    @map("due_on") @db.Date
  createdById   String                      @map("created_by_id") @db.VarChar(64)
  createdByName String                      @map("created_by_name") @db.VarChar(150)
  createdAt     DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  societies     InformationRequestSociety[]

  @@index([createdAt])
  @@map("information_requests")
}

model InformationRequestSociety {
  requestId       String             @map("request_id") @db.Uuid
  request         InformationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  societyId       String             @map("society_id") @db.Uuid
  society         Society            @relation(fields: [societyId], references: [id], onDelete: Cascade)
  respondedAt     DateTime?          @map("responded_at") @db.Timestamptz(3)
  respondedById   String?            @map("responded_by_id") @db.VarChar(64)
  respondedByName String?            @map("responded_by_name") @db.VarChar(150)
  note            String?            @db.VarChar(500)

  @@id([requestId, societyId])
  @@index([societyId, respondedAt])
  @@index([requestId, respondedAt])
  @@map("information_request_societies")
}

// Issue #96: SarvoAI's application spending limit. `committed` is settled cost plus
// reservations still open, per UTC calendar month. Estimates only, in millionths of a
// US dollar. No prompts, answers, people or societies are stored here.
enum AssistantSpendStatus {
  RESERVED
  SETTLED
  RELEASED
  UNCERTAIN

  @@map("assistant_spend_status")
}

model AssistantMonthlySpend {
  // UTC calendar month as YYYY-MM.
  month             String                      @id @db.VarChar(7)
  committedMicroUsd BigInt                      @default(0) @map("committed_micro_usd")
  updatedAt         DateTime                    @default(now()) @map("updated_at") @db.Timestamptz(3)
  reservations      AssistantSpendReservation[]

  @@map("assistant_monthly_spend")
}

model AssistantSpendReservation {
  id               String                @id @db.Uuid
  month            String                @db.VarChar(7)
  monthlySpend     AssistantMonthlySpend @relation(fields: [month], references: [month], onDelete: Restrict)
  modelId          String                @map("model_id") @db.VarChar(120)
  status           AssistantSpendStatus  @default(RESERVED)
  reservedMicroUsd BigInt                @map("reserved_micro_usd")
  actualMicroUsd   BigInt?               @map("actual_micro_usd")
  inputTokens      Int?                  @map("input_tokens")
  cacheWriteTokens Int?                  @map("cache_write_tokens")
  cacheReadTokens  Int?                  @map("cache_read_tokens")
  outputTokens     Int?                  @map("output_tokens")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  closedAt         DateTime?             @map("closed_at") @db.Timestamptz(3)
  hold             AssistantSpendHold?

  @@index([month, status])
  @@map("assistant_spend_reservations")
}

// A call broke its reservation's assumptions. Calls stop until an approval reviews it.
model AssistantSpendHold {
  reservationId    String                    @id @map("reservation_id") @db.Uuid
  reservation      AssistantSpendReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  reasons          String                    @db.VarChar(200)
  reservedMicroUsd BigInt                    @map("reserved_micro_usd")
  actualMicroUsd   BigInt                    @map("actual_micro_usd")
  detectedAt       DateTime                  @default(now()) @map("detected_at") @db.Timestamptz(3)

  @@index([detectedAt])
  @@map("assistant_spend_holds")
}

// Issue #145: Village Economic Profile. Businesses operated by the society
// itself, what each produces, and the production reported for exact covered
// periods. Society -> SocietyBusiness -> BusinessOutput -> ProductionRecord.
// Industry, product and unit codes come from the shared catalogue in
// packages/api-contracts/src/economy.ts. Nothing here is ever deleted: a
// business is closed and an output archived, so past totals stay the same.
enum BusinessStatus {
  OPERATING
  SEASONAL
  TEMPORARILY_STOPPED
  CLOSED

  @@map("business_status")
}

enum ProductionBasis {
  WEEKLY
  MONTHLY
  SEASONAL

  @@map("production_basis")
}

// Actual and estimated figures are kept apart and never added together.
enum ProductionMeasurement {
  ACTUAL
  ESTIMATED

  @@map("production_measurement")
}

model SocietyBusiness {
  id            String           @id @default(uuid()) @db.Uuid
  societyId     String           @map("society_id") @db.Uuid
  society       Society          @relation(fields: [societyId], references: [id], onDelete: Restrict)
  name          String           @db.VarChar(150)
  industry      String           @db.VarChar(40)
  otherIndustry String?          @map("other_industry") @db.VarChar(150)
  description   String?          @db.VarChar(500)
  status        BusinessStatus   @default(OPERATING)
  // Set when the status becomes CLOSED and cleared if it reopens.
  closedAt      DateTime?        @map("closed_at") @db.Timestamptz(3)
  // Raised on every change; an update naming an older version is refused.
  version       Int              @default(1)
  createdById   String           @map("created_by_id") @db.VarChar(64)
  createdByName String           @map("created_by_name") @db.VarChar(150)
  createdByRole String?          @map("created_by_role") @db.VarChar(40)
  updatedByName String?          @map("updated_by_name") @db.VarChar(150)
  updatedByRole String?          @map("updated_by_role") @db.VarChar(40)
  outputs       BusinessOutput[]
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([societyId])
  @@map("society_businesses")
}

model BusinessOutput {
  id               String             @id @default(uuid()) @db.Uuid
  businessId       String             @map("business_id") @db.Uuid
  business         SocietyBusiness    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  product          String             @db.VarChar(40)
  otherDescription String?            @map("other_description") @db.VarChar(150)
  unit             String             @db.VarChar(20)
  archivedAt       DateTime?          @map("archived_at") @db.Timestamptz(3)
  version          Int                @default(1)
  createdById      String             @map("created_by_id") @db.VarChar(64)
  createdByName    String             @map("created_by_name") @db.VarChar(150)
  createdByRole    String?            @map("created_by_role") @db.VarChar(40)
  records          ProductionRecord[]
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([businessId])
  @@index([product])
  @@map("business_outputs")
}

// One record per output, measurement and exact covered period. Periods of the
// same output and measurement never overlap (checked under a row lock on the
// output), so a weekly and a monthly figure are never both counted.
model ProductionRecord {
  id              String                     @id @default(uuid()) @db.Uuid
  outputId        String                     @map("output_id") @db.Uuid
  output          BusinessOutput             @relation(fields: [outputId], references: [id], onDelete: Restrict)
  basis           ProductionBasis
  periodStart     DateTime                   @map("period_start") @db.Date
  periodEnd       DateTime                   @map("period_end") @db.Date
  seasonLabel     String?                    @map("season_label") @db.VarChar(60)
  measurement     ProductionMeasurement
  quantity        Decimal                    @db.Decimal(14, 3)
  note            String?                    @db.VarChar(500)
  source          String?                    @db.VarChar(150)
  version         Int                        @default(1)
  // Sent by the client so a retried save returns the same record.
  clientRequestId String?                    @unique @map("client_request_id") @db.Uuid
  createdById     String                     @map("created_by_id") @db.VarChar(64)
  createdByName   String                     @map("created_by_name") @db.VarChar(150)
  createdByRole   String?                    @map("created_by_role") @db.VarChar(40)
  updatedByName   String?                    @map("updated_by_name") @db.VarChar(150)
  updatedByRole   String?                    @map("updated_by_role") @db.VarChar(40)
  revisions       ProductionRecordRevision[]
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([outputId, measurement, periodStart, periodEnd])
  @@index([periodStart, periodEnd])
  @@map("production_records")
}

// Every saved version of a record, including the first. A correction adds a
// row; the record itself always holds the current figure.
model ProductionRecordRevision {
  id            String           @id @default(uuid()) @db.Uuid
  recordId      String           @map("record_id") @db.Uuid
  record        ProductionRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)
  version       Int
  change        String           @db.VarChar(20)
  quantity      Decimal          @db.Decimal(14, 3)
  seasonLabel   String?          @map("season_label") @db.VarChar(60)
  note          String?          @db.VarChar(500)
  source        String?          @db.VarChar(150)
  changedById   String           @map("changed_by_id") @db.VarChar(64)
  changedByName String           @map("changed_by_name") @db.VarChar(150)
  changedByRole String?          @map("changed_by_role") @db.VarChar(40)
  changedAt     DateTime         @default(now()) @map("changed_at") @db.Timestamptz(3)

  @@unique([recordId, version])
  @@map("production_record_revisions")
}
