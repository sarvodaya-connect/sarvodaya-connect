generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Provisional values based on the Sarvodaya proposal (Society status).
// To be confirmed with Sarvodaya.
enum SocietyStatus {
  ACTIVE
  INACTIVE
  UNDER_REVIEW
  SUSPENDED

  @@map("society_status")
}

enum MembershipCategory {
  CHILDREN
  YOUTH
  MOTHERS
  ORDINARY
  ELDERS_COUNCIL

  @@map("membership_category")
}

enum SocietyGrade {
  A
  B
  C

  @@map("society_grade")
}

enum GradeChangeStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("grade_change_status")
}

enum SocietyAssignmentRole {
  SOCIETY_OFFICER
  SPC

  @@map("society_assignment_role")
}

model District {
  id                 String              @id @default(uuid()) @db.Uuid
  code               String              @unique @db.VarChar(10)
  nameEn             String              @unique @map("name_en") @db.VarChar(100)
  societies          Society[]
  emergencyIncidents EmergencyIncident[]
  ddmDelegations     DistrictDelegation[]
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("districts")
}

model Society {
  id                   String                     @id @default(uuid()) @db.Uuid
  societyCode          String                     @unique @map("society_code") @db.VarChar(20)
  nameEn               String                     @map("name_en") @db.VarChar(150)
  nameLocal            String?                    @map("name_local") @db.VarChar(150)
  districtId           String                     @map("district_id") @db.Uuid
  district             District                   @relation(fields: [districtId], references: [id], onDelete: Restrict)
  dsDivision           String?                    @map("ds_division") @db.VarChar(100)
  gnDivision           String?                    @map("gn_division") @db.VarChar(100)
  village              String?                    @db.VarChar(100)
  addressLine          String?                    @map("address_line") @db.VarChar(255)
  latitude             Float?
  longitude            Float?
  establishedOn        DateTime?                  @map("established_on") @db.Date
  status               SocietyStatus              @default(UNDER_REVIEW)
  grade                SocietyGrade                @default(C)
  contacts             SocietyContact[]
  councilMembers       SocietyCouncilMember[]
  memberships          SocietyMembershipCount[]
  documents            SocietyDocument[]
  notifications        Notification[]
  emergencyAssessments EmergencyAssessment[]
  emergencyActions     EmergencyResponseAction[]
  emergencyReports     EmergencySituationReport[]
  gradeChangeRequests  GradeChangeRequest[]
  auditEvents          SocietyAuditEvent[]
  assignments          SocietyAssignment[]
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([districtId])
  @@index([status])
  @@index([nameEn])
  @@map("societies")
}

model SocietyAssignment {
  id           String                @id @default(uuid()) @db.Uuid
  societyId    String                @map("society_id") @db.Uuid
  society      Society               @relation(fields: [societyId], references: [id], onDelete: Cascade)
  role         SocietyAssignmentRole
  userId       String                @map("user_id") @db.VarChar(64)
  assignedById String                @map("assigned_by_id") @db.VarChar(64)
  assignedAt   DateTime              @default(now()) @map("assigned_at") @db.Timestamptz(3)
  revokedAt    DateTime?             @map("revoked_at") @db.Timestamptz(3)

  @@unique([societyId, role, userId])
  @@index([userId, role, revokedAt])
  @@map("society_assignments")
}

model DistrictDelegation {
  id            String    @id @default(uuid()) @db.Uuid
  districtId    String    @map("district_id") @db.Uuid
  district      District  @relation(fields: [districtId], references: [id], onDelete: Cascade)
  deputyUserId  String    @map("deputy_user_id") @db.VarChar(64)
  grantedById   String    @map("granted_by_id") @db.VarChar(64)
  grantedByName String    @map("granted_by_name") @db.VarChar(150)
  startsAt      DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime  @map("ends_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedById   String?   @map("revoked_by_id") @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([deputyUserId, districtId, startsAt, endsAt])
  @@index([districtId, endsAt])
  @@map("district_delegations")
}

model GradeChangeRequest {
  id               String            @id @default(uuid()) @db.Uuid
  societyId        String            @map("society_id") @db.Uuid
  society          Society           @relation(fields: [societyId], references: [id], onDelete: Restrict)
  currentGrade     SocietyGrade      @map("current_grade")
  proposedGrade    SocietyGrade      @map("proposed_grade")
  rationale        String            @db.VarChar(2000)
  status           GradeChangeStatus @default(PENDING)
  requestedById    String            @map("requested_by_id") @db.VarChar(64)
  requestedByName  String            @map("requested_by_name") @db.VarChar(150)
  requestedAt      DateTime          @default(now()) @map("requested_at") @db.Timestamptz(3)
  decidedById      String?           @map("decided_by_id") @db.VarChar(64)
  decidedByName    String?           @map("decided_by_name") @db.VarChar(150)
  decisionComment  String?           @map("decision_comment") @db.VarChar(2000)
  decidedAt        DateTime?         @map("decided_at") @db.Timestamptz(3)
  auditEvents      SocietyAuditEvent[]

  @@index([status, requestedAt])
  @@index([societyId, requestedAt])
  @@map("grade_change_requests")
}

model SocietyAuditEvent {
  id                 String              @id @default(uuid()) @db.Uuid
  societyId          String              @map("society_id") @db.Uuid
  society            Society             @relation(fields: [societyId], references: [id], onDelete: Restrict)
  gradeChangeRequestId String?           @map("grade_change_request_id") @db.Uuid
  gradeChangeRequest GradeChangeRequest? @relation(fields: [gradeChangeRequestId], references: [id], onDelete: SetNull)
  eventType          String              @map("event_type") @db.VarChar(40)
  fromGrade          SocietyGrade?       @map("from_grade")
  toGrade            SocietyGrade?       @map("to_grade")
  summary            String              @db.VarChar(500)
  comment            String?             @db.VarChar(2000)
  actorId            String              @map("actor_id") @db.VarChar(64)
  actorDisplayName   String              @map("actor_display_name") @db.VarChar(150)
  occurredAt         DateTime            @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([societyId, occurredAt])
  @@map("society_audit_events")
}

model SocietyContact {
  id        String   @id @default(uuid()) @db.Uuid
  societyId String   @map("society_id") @db.Uuid
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  label     String?  @db.VarChar(100)
  fullName  String?  @map("full_name") @db.VarChar(150)
  position  String?  @db.VarChar(100)
  phone     String?  @db.VarChar(30)
  email     String?  @db.VarChar(254)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([societyId])
  @@map("society_contacts")
}

model SocietyCouncilMember {
  id               String             @id @default(uuid()) @db.Uuid
  societyId        String             @map("society_id") @db.Uuid
  society          Society            @relation(fields: [societyId], references: [id], onDelete: Cascade)
  seatNumber       Int                @map("seat_number")
  fullName         String             @map("full_name") @db.VarChar(150)
  position         String             @db.VarChar(100)
  seatType         MembershipCategory @map("seat_type")
  phone            String?            @db.VarChar(30)
  email            String?            @db.VarChar(254)
  age              Int?
  appointedOn      DateTime?          @map("appointed_on") @db.Date
  endedOn          DateTime?          @map("ended_on") @db.Date
  isActive         Boolean            @default(true) @map("is_active")
  isPrimaryContact Boolean            @default(false) @map("is_primary_contact")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([societyId, seatNumber])
  @@index([societyId, isActive])
  @@map("society_council_members")
}

model SocietyMembershipCount {
  id        String             @id @default(uuid()) @db.Uuid
  societyId String             @map("society_id") @db.Uuid
  society   Society            @relation(fields: [societyId], references: [id], onDelete: Cascade)
  year      Int
  category  MembershipCategory
  female    Int                @default(0)
  male      Int                @default(0)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([societyId, year, category])
  @@index([year, societyId])
  @@map("society_membership_counts")
}

// SC-49: document metadata. Files live in document storage (local disk in
// development, Amazon S3 later); only their metadata is stored here.
// Types follow the four annual Registrar documents plus other society files.
// To be confirmed with Sarvodaya.
enum DocumentType {
  AUDIT_REPORT
  AGM_MINUTES
  OFFICE_BEARER_LIST
  MEMBERS_LIST
  REGISTRATION
  FINANCE
  ACTIVITY_EVIDENCE
  OTHER

  @@map("document_type")
}

// Matches DOCUMENT_STATUSES in packages/api-contracts. A document stays DRAFT
// until its file has been uploaded and confirmed.
enum DocumentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED

  @@map("document_status")
}

// REVIEWERS_ONLY documents (the signed members list) can only be opened by
// District Managers and HQ.
enum DocumentAccessLevel {
  STANDARD
  REVIEWERS_ONLY

  @@map("document_access_level")
}

model SocietyDocument {
  id             String              @id @default(uuid()) @db.Uuid
  societyId      String              @map("society_id") @db.Uuid
  society        Society             @relation(fields: [societyId], references: [id], onDelete: Restrict)
  documentType   DocumentType        @map("document_type")
  title          String              @db.VarChar(150)
  fileName       String              @map("file_name") @db.VarChar(255)
  contentType    String              @map("content_type") @db.VarChar(100)
  sizeBytes      Int                 @map("size_bytes")
  // Location in document storage. Never contains user-supplied text.
  storageKey     String              @unique @map("storage_key") @db.VarChar(512)
  status         DocumentStatus      @default(DRAFT)
  accessLevel    DocumentAccessLevel @default(STANDARD) @map("access_level")
  version        Int                 @default(1)
  // Users are managed by the identity provider, so only their id and display name are kept.
  uploadedById   String              @map("uploaded_by_id") @db.VarChar(64)
  uploadedByName String              @map("uploaded_by_name") @db.VarChar(150)
  uploadedAt     DateTime?           @map("uploaded_at") @db.Timestamptz(3)
  notifications  Notification[]
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([societyId, documentType, title, version])
  @@index([societyId, documentType])
  @@index([status])
  @@map("society_documents")
}

// SC-49: notifications for dashboard and mobile users. Categories follow the
// notification centre (Screen Catalogue v3, D19 and M16).
enum NotificationCategory {
  APPROVAL
  RETURNED
  AUDIT
  REQUEST
  EMERGENCY
  STALE_DATA
  SYSTEM

  @@map("notification_category")
}

enum EmergencyIncidentType {
  FLOOD
  LANDSLIDE
  CYCLONE
  DROUGHT
  FIRE
  PUBLIC_HEALTH
  OTHER

  @@map("emergency_incident_type")
}

enum EmergencySeverity {
  LOW
  MODERATE
  HIGH
  CRITICAL

  @@map("emergency_severity")
}

enum EmergencyIncidentStatus {
  ACTIVE
  CONTAINED
  CLOSED

  @@map("emergency_incident_status")
}

enum EmergencyRecordStatus {
  DRAFT
  SUBMITTED

  @@map("emergency_record_status")
}

enum EmergencyActionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("emergency_action_status")
}

model Notification {
  id              String               @id @default(uuid()) @db.Uuid
  recipientUserId String               @map("recipient_user_id") @db.VarChar(64)
  category        NotificationCategory
  title           String               @db.VarChar(200)
  body            String?              @db.VarChar(1000)
  // Relative path in the app or dashboard that shows the related item.
  linkPath        String?              @map("link_path") @db.VarChar(255)
  societyId       String?              @map("society_id") @db.Uuid
  society         Society?             @relation(fields: [societyId], references: [id], onDelete: SetNull)
  documentId      String?              @map("document_id") @db.Uuid
  document        SocietyDocument?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  readAt          DateTime?            @map("read_at") @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([recipientUserId, createdAt])
  @@index([recipientUserId, readAt])
  @@map("notifications")
}

// Emergency-response data uses fictional/demo content until approved for live use.
model EmergencyIncident {
  id          String                     @id @default(uuid()) @db.Uuid
  districtId  String                     @map("district_id") @db.Uuid
  district    District                   @relation(fields: [districtId], references: [id], onDelete: Restrict)
  title       String                     @db.VarChar(160)
  type        EmergencyIncidentType
  severity    EmergencySeverity
  status      EmergencyIncidentStatus    @default(ACTIVE)
  description String                     @db.VarChar(4000)
  location    String                     @db.VarChar(200)
  latitude    Float?
  longitude   Float?
  createdById String                     @map("created_by_id") @db.VarChar(64)
  activatedAt DateTime                   @default(now()) @map("activated_at") @db.Timestamptz(3)
  closedAt    DateTime?                  @map("closed_at") @db.Timestamptz(3)
  assessments EmergencyAssessment[]
  actions     EmergencyResponseAction[]
  reports     EmergencySituationReport[]
  createdAt   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([districtId, status, activatedAt])
  @@map("emergency_incidents")
}

model EmergencyAssessment {
  id                  String                @id @default(uuid()) @db.Uuid
  incidentId          String                @map("incident_id") @db.Uuid
  incident            EmergencyIncident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  societyId           String                @map("society_id") @db.Uuid
  society             Society               @relation(fields: [societyId], references: [id], onDelete: Restrict)
  clientMutationId    String                @map("client_mutation_id") @db.Uuid
  revision            Int                   @default(1)
  status              EmergencyRecordStatus @default(DRAFT)
  observedAt          DateTime              @map("observed_at") @db.Timestamptz(3)
  peopleAffected      Int                   @default(0) @map("people_affected")
  householdsAffected  Int                   @default(0) @map("households_affected")
  displacedPeople     Int                   @default(0) @map("displaced_people")
  infrastructureNotes String                @default("") @map("infrastructure_notes") @db.VarChar(2000)
  urgentNeeds         String                @default("") @map("urgent_needs") @db.VarChar(2000)
  notes               String                @default("") @db.VarChar(4000)
  latitude            Float?
  longitude           Float?
  createdById         String                @map("created_by_id") @db.VarChar(64)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([createdById, clientMutationId])
  @@index([incidentId, societyId, status])
  @@map("emergency_assessments")
}

model EmergencyResponseAction {
  id               String                @id @default(uuid()) @db.Uuid
  incidentId       String                @map("incident_id") @db.Uuid
  incident         EmergencyIncident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  societyId        String?               @map("society_id") @db.Uuid
  society          Society?              @relation(fields: [societyId], references: [id], onDelete: SetNull)
  clientMutationId String                @map("client_mutation_id") @db.Uuid
  title            String                @db.VarChar(160)
  description      String                @default("") @db.VarChar(2000)
  status           EmergencyActionStatus @default(PLANNED)
  dueAt            DateTime?             @map("due_at") @db.Timestamptz(3)
  createdById      String                @map("created_by_id") @db.VarChar(64)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([createdById, clientMutationId])
  @@index([incidentId, status, dueAt])
  @@map("emergency_response_actions")
}

model EmergencySituationReport {
  id               String                @id @default(uuid()) @db.Uuid
  incidentId       String                @map("incident_id") @db.Uuid
  incident         EmergencyIncident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  societyId        String?               @map("society_id") @db.Uuid
  society          Society?              @relation(fields: [societyId], references: [id], onDelete: SetNull)
  clientMutationId String                @map("client_mutation_id") @db.Uuid
  revision         Int                   @default(1)
  status           EmergencyRecordStatus @default(DRAFT)
  summary          String                @db.VarChar(4000)
  needs            String                @default("") @db.VarChar(2000)
  createdById      String                @map("created_by_id") @db.VarChar(64)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([createdById, clientMutationId], map: "emergency_situation_reports_created_by_id_client_mutation_i_key")
  @@index([incidentId, status, createdAt])
  @@map("emergency_situation_reports")
}
