NODE_ENV=development
API_PORT=3001

DATABASE_URL=postgresql://username:password@localhost:5432/sarvodaya_connect

NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Document storage (SC-49). "local" stores files in LOCAL_STORAGE_DIR for development;
# "s3" uses Amazon S3 pre-signed URLs. Never commit real secrets or AWS keys.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.local-storage
STORAGE_SIGNING_SECRET=replace-with-a-long-random-development-value
STORAGE_URL_TTL_SECONDS=900
API_PUBLIC_URL=http://localhost:3001
# S3_BUCKET=
# S3_REGION=

# V4 local identity. Never use the local credential service for a production release.
# Start with identity:bootstrap to create the first HQ invitation.
DATABASE_CONNECTION_LIMIT=2
# Required to save/reveal NICs: generate 32 random bytes as 64 hex characters locally.
# Store it separately from PostgreSQL. Preserve it when restoring a database backup.
NIC_ENCRYPTION_KEY=
# Explicit dashboard-only fictional demonstration mode; leave false for API-backed accounts.
PLATFORM_DEMO_MODE=false
API_BASE_URL=http://localhost:3001/api/v1

# SarvoAI (HQ-only question assistant) on Amazon Bedrock. Leave false locally: the endpoint
# then answers 503 and nothing is sent to AWS. To switch it on, give the API's IAM role access to
# this one model (infrastructure/aws/sarvoai-bedrock-policy.json) and see docs/sarvoai-aws-setup.md.
SARVOAI_ENABLED=false
# Global inference profile: the only way to reach Haiku 5.5 from Singapore. Requests may be
# processed in any supported AWS commercial Region (see docs/sarvoai-aws-setup.md).
SARVOAI_MODEL_ID=global.anthropic.claude-haiku-5-5
SARVOAI_AWS_REGION=ap-southeast-1
