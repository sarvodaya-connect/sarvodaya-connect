# Each setting is marked [config] (plain configuration, safe to keep in deployment settings)
# or [secret] (keep in AWS Secrets Manager or SSM Parameter Store; never commit a real value).
# docs/aws-configuration.md lists the same settings for AWS.

# [config]
NODE_ENV=development
# [config]
API_PORT=3001

# [secret] Database connection, including its password.
DATABASE_URL=postgresql://username:password@localhost:5432/sarvodaya_connect
# Set by SAM for TEST Lambda only; local PostgreSQL does not need this setting.
# NODE_EXTRA_CA_CERTS=/var/task/certificates/rds-ap-southeast-1.pem

# [config]
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# [config] Mapbox PUBLIC token (pk.), for the dashboard's street maps. Designed to be visible in the
# browser; restrict it to the dashboard's URLs in the Mapbox account. Not a secret, but never commit
# a real value: put it in apps/dashboard/.env.local, or in Amplify. Empty shows the drawn maps.
# The phone takes the same public token at build time: --dart-define=MAPBOX_TOKEN=pk...
NEXT_PUBLIC_MAPBOX_TOKEN=

# Document storage (SC-49). "local" stores files in LOCAL_STORAGE_DIR for development;
# "s3" uses Amazon S3 pre-signed URLs. Never commit real secrets or AWS keys.
# [config]
STORAGE_DRIVER=local
# [config]
LOCAL_STORAGE_DIR=.local-storage
# [secret]
STORAGE_SIGNING_SECRET=replace-with-a-long-random-development-value
# [config]
STORAGE_URL_TTL_SECONDS=900
# [config]
API_PUBLIC_URL=http://localhost:3001
# [config]
# S3_BUCKET=
# [config]
# S3_REGION=
# [config] V5 PR 10: a local S3-compatible store (MinIO) for development and the smoke test only,
# for example http://localhost:9000. Path-style; refused in production.
# S3_ENDPOINT_URL=
# [secret] S3 signing keys. On AWS Lambda these come from the function's IAM role automatically
# (the runtime sets them); set them by hand only for a local MinIO, never commit real values.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# [config] V5 PR 4: largest document upload in bytes (PDF or photo). Default 10 MB; at most 50 MB.
DOCUMENT_MAX_UPLOAD_BYTES=10000000
# [config] Browser origins allowed to PUT/GET local-storage upload links (development driver only;
# S3 uploads use the bucket's CORS rules). Leave empty in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# V5 PR 10: who signs users in. "local" (passwords and sessions in PostgreSQL) for development and
# tests; "cognito" (Amazon Cognito user pool tokens) is the default and the only choice in production.
# Either way, roles, districts, societies and temporary access are read from the database.
# [config]
AUTH_PROVIDER=local
# [config] Only when AUTH_PROVIDER=cognito: the user pool and its public app client ids
# (comma-separated; no client secret). The dashboard reads the same names (its own client id).
# Not secrets. AWS credentials for HQ account administration come from the Lambda role, or your
# own AWS_PROFILE locally against a test pool; never put AWS keys here. See docs/cognito-setup.md.
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# [config] Optional: must match the region in COGNITO_USER_POOL_ID.
# COGNITO_REGION=
# [config] "access" (default) or "id": which Cognito token the clients send.
# COGNITO_TOKEN_USE=access
# [config] "json" for one JSON object per log line (the default on Lambda and in production) or "text".
# LOG_FORMAT=

# V4 local identity. Never use the local credential service for a production release.
# Start with identity:bootstrap to create the first HQ invitation.
# [config]
DATABASE_CONNECTION_LIMIT=2
# [secret] Required to save/reveal NICs: generate 32 random bytes as 64 hex characters locally.
# Store it separately from PostgreSQL. Preserve it when restoring a database backup.
NIC_ENCRYPTION_KEY=
# [config] Explicit dashboard-only fictional demonstration mode; leave false for API-backed accounts.
PLATFORM_DEMO_MODE=false
# [config]
API_BASE_URL=http://localhost:3001/api/v1

# [config] V5 PR 7: longest temporary DDM access a District Manager can give, in days (1-90).
DISTRICT_ACCESS_MAX_DAYS=14

# SarvoAI (HQ-only question assistant) on Amazon Bedrock. Leave false locally: the endpoint
# then answers 503 and nothing is sent to AWS. To switch it on, give the API's IAM role access to
# this one model (infrastructure/aws/sarvoai-bedrock-policy.json) and see docs/sarvoai-aws-setup.md.
# No API key is used: requests are signed with the API's IAM role.
# [config] Feature flag, off by default.
SARVOAI_ENABLED=false
# [config] Global inference profile: the only way to reach Haiku 5.5 from Singapore. Requests may be
# processed in any supported AWS commercial Region (see docs/sarvoai-aws-setup.md).
SARVOAI_MODEL_ID=global.anthropic.claude-haiku-5-5
# [config]
SARVOAI_AWS_REGION=ap-southeast-1
# [config] Most SarvoAI may spend per UTC calendar month, in US dollars, estimated by the
# application (0 to 1000; 0 refuses every call; an invalid value also refuses every call).
# A ceiling, not a forecast or an allocation, and not an AWS billing cap.
SARVOAI_MONTHLY_LIMIT_USD=20
# [config] Optional. USD per million tokens, if the Bedrock price differs from the Claude
# Haiku 5.5 list price (0.10 input, 0.50 output). Required for any other model.
# SARVOAI_INPUT_USD_PER_MTOK=
# SARVOAI_OUTPUT_USD_PER_MTOK=

# [config] Lambda test only: load database-url and nic-encryption-key SecureStrings
# at cold start with the execution role. Leave unset for local development.
# CONFIG_PARAMETER_PREFIX=/sarvodaya-connect/test
